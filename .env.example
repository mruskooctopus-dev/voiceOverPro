# VoiceFlow Pro Environment Configuration
# Copy this file to .env and fill in your values

# Node-RED credential encryption secret
NODE_RED_CREDENTIAL_SECRET=change-this-to-a-random-string

# ElevenLabs TTS (Primary Provider)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Google TTS (Fallback Provider - Optional)
GOOGLE_TTS_API_KEY=

# Amazon Polly (Fallback Provider - Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Octopus Newsroom API
OCTOPUS_API_URL=https://your-octopus-instance.com/api
OCTOPUS_API_KEY=your-octopus-api-key-here
